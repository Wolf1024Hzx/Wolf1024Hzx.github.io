---
interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} | 小狼的小窝` : '小狼的小窝';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="众所周知，小狼在冬眠时是不会离开他的小窝的" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <nav>
        <a class="site-title" href="/">小狼的小窝</a>
        <span class="nav-links">
          <a href="/archives/">归档</a>
          <a href="/tags/">标签</a>
          <a href="/categories/">分类</a>
          <a href="/about/">关于</a>
        </span>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} wolf1024hzx &middot; Powered by <a href="https://astro.build">Astro</a></p>
    </footer>
  </body>
</html>

<style>
  /* 临时基础样式，仅保证可读性；正式样式待功能完善后重做 */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    max-width: 46rem;
    margin: 0 auto;
    padding: 0 1rem;
    font-family: system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    line-height: 1.7;
    color: #222;
  }

  header nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid #e5e5e5;
  }

  .site-title {
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
    color: inherit;
  }

  .nav-links a {
    margin-left: 1rem;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  pre {
    overflow-x: auto;
    padding: 0.75rem;
  }

  footer {
    margin-top: 3rem;
    padding: 1rem 0;
    border-top: 1px solid #e5e5e5;
    font-size: 0.85rem;
    color: #888;
  }
</style>
