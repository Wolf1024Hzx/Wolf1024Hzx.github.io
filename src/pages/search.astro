---
import Base from '../layouts/Base.astro';
---

<Base title="搜索">
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script slot="head" is:inline src="/pagefind/pagefind-ui.js"></script>
  <header class="page-header">
    <h1>搜索</h1>
    <p class="page-desc">输入关键词，检索全部文章</p>
  </header>
  <div id="search"></div>
  <p id="search-hint" class="search-hint" hidden>
    搜索索引尚未构建，运行 <code>npm run build</code> 后通过 <code>npm run preview</code> 预览即可使用。
  </p>
  <script is:inline>
    (function () {
      // dev 模式下没有 pagefind 索引资源，给出构建提示
      if (typeof window.PagefindUI !== 'function') {
        var hint = document.getElementById('search-hint');
        if (hint) hint.hidden = false;
        return;
      }
      new window.PagefindUI({
        element: '#search',
        showImages: false,
        showSubResults: true,
        translations: {
          placeholder: '搜索文章',
          clear_search: '清除',
          load_more: '加载更多结果',
          search_label: '站内搜索',
          filters_label: '筛选',
          zero_results: '没有找到与「[SEARCH_TERM]」相关的内容',
          many_results: '找到 [COUNT] 条与「[SEARCH_TERM]」相关的结果',
          one_result: '找到 [COUNT] 条与「[SEARCH_TERM]」相关的结果',
          alt_search: '没有找到与「[SEARCH_TERM]」相关的内容，改为显示「[DIFFERENT_TERM]」的结果',
          search_suggestion: '没有找到与「[SEARCH_TERM]」相关的内容，试试以下搜索：',
          searching: '正在搜索「[SEARCH_TERM]」…',
        },
      });
    })();
  </script>
</Base>
