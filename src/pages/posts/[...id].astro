---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getSortedPosts, toArray, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const categories = toArray(post.data.categories);
// 与分类重名的标签不再重复展示
const tags = toArray(post.data.tags).filter((t) => !categories.includes(t));

// 目录取前三级标题，缩进以出现过的最小层级为基准归一化
const tocHeadings = headings.filter((h) => h.depth <= 3);
const minDepth = Math.min(...tocHeadings.map((h) => h.depth));
const showToc = tocHeadings.length >= 2;
---

<Base title={post.data.title}>
  <article class="post-article" data-pagefind-body>
    <header class="post-header">
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {
          categories.map((c) => (
            <>
              <span class="sep">&middot;</span>
              <a href={`/categories/${c}/`}>{c}</a>
            </>
          ))
        }
        {
          tags.map((t) => (
            <>
              <span class="sep">&middot;</span>
              <a href={`/tags/${t}/`}>{t}</a>
            </>
          ))
        }
      </p>
    </header>
    {
      showToc && (
        <nav class="toc" aria-label="文章目录">
          <div class="toc-inner">
            <p class="toc-title">目录</p>
            <ul>
              {tocHeadings.map((h) => (
                <li>
                  <a href={`#${h.slug}`} style={`--depth: ${h.depth - minDepth}`}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post-article {
    position: relative;
  }

  /* ---------- 文章目录（宽屏右侧悬浮） ---------- */
  .toc {
    display: none;
  }

  @media (min-width: 1280px) {
    .toc {
      display: block;
      position: absolute;
      left: calc(100% + 2.5rem);
      top: 0;
      width: 13rem;
      height: 100%;
    }

    .toc-inner {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }
  }

  .toc-title {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--text-faint);
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .toc a {
    display: block;
    margin-left: -1px;
    padding: 0.2rem 0 0.2rem calc(0.9rem * (var(--depth) + 1));
    border-left: 1px solid transparent;
    font-size: 0.83rem;
    line-height: 1.5;
    color: var(--text-soft);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .toc a:hover {
    color: var(--accent);
  }

  .toc a.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }
</style>

<script is:inline>
  // 滚动监听：高亮当前章节对应的目录项
  (function () {
    var links = document.querySelectorAll('.toc a');
    if (!links.length) return;
    var linkById = new Map();
    links.forEach(function (a) {
      linkById.set(decodeURIComponent(a.hash.slice(1)), a);
    });
    var current = null;
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          var link = linkById.get(e.target.id);
          if (!link) return;
          if (current) current.classList.remove('active');
          link.classList.add('active');
          current = link;
        });
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    document
      .querySelectorAll('.prose h1[id], .prose h2[id], .prose h3[id]')
      .forEach(function (h) {
        observer.observe(h);
      });
  })();
</script>
