---
import Base from '../layouts/Base.astro';
import { getSortedPosts, formatDate } from '../lib/posts';

const posts = await getSortedPosts();
// 置顶文章排在最前，其余按日期倒序（getSortedPosts 已保证有序，直接两段拼接即可）
const pinnedPosts = posts.filter((p) => p.data.pinned);
const orderedPosts = [...pinnedPosts, ...posts.filter((p) => !p.data.pinned)];
const oldestYear = posts[posts.length - 1]?.data.date.getFullYear();
---

<Base>
  <section class="hero">
    <p class="hero-meta">
      <span>EST. {oldestYear}</span>
      <span class="hero-meta-dot" aria-hidden="true"></span>
      <span>共 {posts.length} 篇</span>
    </p>
    <p class="slogan">但屈指西风几时来，<br />又不道流年暗中偷换</p>
    <div class="hero-rule" aria-hidden="true"></div>
  </section>
  <ul class="post-list">
    {
      orderedPosts.map((post, index) => (
        <li style={`--i: ${Math.min(index, 12)}`}>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {post.data.pinned && <span class="pin-badge">置顶</span>}
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        </li>
      ))
    }
  </ul>
</Base>
