---
import Base from '../layouts/Base.astro';
import { getSortedPosts, formatDate } from '../lib/posts';

const posts = await getSortedPosts();
// 置顶文章单独成一个分区，其余按日期倒序（getSortedPosts 已保证有序）
const pinnedPosts = posts.filter((p) => p.data.pinned);
const restPosts = posts.filter((p) => !p.data.pinned);
const oldestYear = posts[posts.length - 1]?.data.date.getUTCFullYear();
// 列表入场动画错峰上限：前 12 条逐条延迟，之后齐播（--i 供 components.css 的 animation-delay 使用）
const STAGGER_CAP = 12;
---

<Base>
  <section class="hero">
    <p class="hero-meta">
      <span>EST. {oldestYear}</span>
      <span class="hero-meta-dot" aria-hidden="true"></span>
      <span>共 {posts.length} 篇</span>
    </p>
    <p class="slogan">但屈指西风几时来，<br />又不道流年暗中偷换</p>
    <div class="hero-rule" aria-hidden="true"></div>
  </section>
  {
    pinnedPosts.length > 0 && (
      <section class="pinned-section">
        <p class="pinned-label">置顶</p>
        <ul class="post-list">
          {pinnedPosts.map((post, index) => (
            <li style={`--i: ${Math.min(index, STAGGER_CAP)}`}>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
        <div class="pinned-rule" aria-hidden="true" />
      </section>
    )
  }
  <ul class="post-list">
    {
      restPosts.map((post, index) => (
        <li style={`--i: ${Math.min(pinnedPosts.length + index, STAGGER_CAP)}`}>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        </li>
      ))
    }
  </ul>
</Base>
