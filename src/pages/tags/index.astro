---
import Base from '../../layouts/Base.astro';
import { getSortedPosts, groupBy } from '../../lib/posts';

const tags = groupBy(await getSortedPosts(), 'tags');
---

<Base title="标签">
  <header class="page-header">
    <h1>标签</h1>
    <p class="page-desc">共 {tags.size} 个</p>
  </header>
  <ul class="pill-list">
    {
      [...tags.entries()].map(([tag, posts]) => (
        <li>
          <a href={`/tags/${tag}/`}>
            {tag}
            <span class="count">{posts.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
