---
import Base from '../../layouts/Base.astro';
import PillList from '../../components/PillList.astro';
import { getSortedPosts, groupBy } from '../../lib/posts';

const tags = groupBy(await getSortedPosts(), 'tags');
---

<Base title="标签">
  <header class="page-header">
    <h1>标签</h1>
    <p class="page-desc">共 {tags.size} 个</p>
  </header>
  <PillList entries={[...tags.entries()]} base="/tags/" />
</Base>
