---
import Base from '../../layouts/Base.astro';
import { getSortedPosts, groupBy } from '../../lib/posts';

const categories = groupBy(await getSortedPosts(), 'categories');
---

<Base title="分类">
  <header class="page-header">
    <h1>分类</h1>
    <p class="page-desc">共 {categories.size} 个</p>
  </header>
  <ul class="pill-list">
    {
      [...categories.entries()].map(([category, posts]) => (
        <li>
          <a href={`/categories/${category}/`}>
            {category}
            <span class="count">{posts.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
