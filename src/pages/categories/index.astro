---
import Base from '../../layouts/Base.astro';
import PillList from '../../components/PillList.astro';
import { getSortedPosts, groupBy } from '../../lib/posts';

const categories = groupBy(await getSortedPosts(), 'categories');
---

<Base title="分类">
  <header class="page-header">
    <h1>分类</h1>
    <p class="page-desc">共 {categories.size} 个</p>
  </header>
  <PillList entries={[...categories.entries()]} base="/categories/" />
</Base>
