---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getSortedPosts, groupBy } from '../../lib/posts';

export async function getStaticPaths() {
  const categories = groupBy(await getSortedPosts(), 'categories');
  return [...categories.entries()].map(([category, posts]) => ({
    params: { category },
    props: { posts },
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`分类：${category}`}>
  <header class="page-header">
    <h1>分类：{category}</h1>
    <p class="page-desc">共 {posts.length} 篇</p>
  </header>
  <PostList posts={posts} />
</Base>
