---
import Base from '../../layouts/Base.astro';
import { getSortedPosts, groupBy, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const categories = groupBy(await getSortedPosts(), 'categories');
  return [...categories.entries()].map(([category, posts]) => ({
    params: { category },
    props: { posts },
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`分类：${category}`}>
  <h1>分类：{category}</h1>
  <ul>
    {
      posts.map((post: (typeof posts)[number]) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  ul {
    list-style: none;
    padding: 0;
  }

  li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.2rem 0;
  }

  time {
    font-size: 0.85rem;
    color: #888;
    font-variant-numeric: tabular-nums;
  }
</style>
