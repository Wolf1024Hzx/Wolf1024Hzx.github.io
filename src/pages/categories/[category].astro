---
import Base from '../../layouts/Base.astro';
import { getSortedPosts, groupBy, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const categories = groupBy(await getSortedPosts(), 'categories');
  return [...categories.entries()].map(([category, posts]) => ({
    params: { category },
    props: { posts },
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`分类：${category}`}>
  <header class="page-header">
    <h1>分类：{category}</h1>
    <p class="page-desc">共 {posts.length} 篇</p>
  </header>
  <ul class="post-list">
    {
      posts.map((post: (typeof posts)[number]) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        </li>
      ))
    }
  </ul>
</Base>
